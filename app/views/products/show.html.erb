<section class="section"><div class="container"><div class="product-detail"><div class="detail-image"><%= product_image(@product) %></div><div class="detail-copy"><div class="eyebrow"><%= @product.category.name %></div><h1><%= @product.name %></h1><p><%= @product.description.presence || @product.short_description %></p><div class="detail-box"><div><span>التصنيف</span><strong><%= @product.category.name %></strong></div><div><span>العلامة التجارية</span><strong><%= @product.brand&.name || "Print Media" %></strong></div><div><span>رقم الموديل</span><strong><%= @product.model_number.presence || "متاح عند الطلب" %></strong></div></div><%= link_to "استفسر عن هذا المنتج عبر واتساب", whatsapp_link(@product), class: "button orange", target: "_blank", rel: "noopener" %></div></div></div></section>