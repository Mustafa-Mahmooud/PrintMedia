<div class="section-head"><div><div class="eyebrow">إدارة الكتالوج</div><h1>العلامات التجارية</h1></div><%= link_to "إضافة علامة +", new_admin_brand_path, class: "button orange" %></div><div class="product-grid" style="grid-template-columns:1fr 1fr"><% @brands.each do |brand| %><div class="product-card"><div class="product-content"><h3><%= brand.name %></h3><p><%= brand.products.count %> منتجات</p><div class="product-actions"><%= link_to "تعديل", edit_admin_brand_path(brand), class: "button ghost" %><%= button_to "حذف", admin_brand_path(brand), method: :delete, class: "button" %></div></div></div><% end %></div>