<%= form_with model: [:admin, category], multipart: true do |form| %><div style="display:grid;gap:15px;max-width:650px"><%= form.label :name, "اسم التصنيف" %><%= form.text_field :name, class: "field" %><%= form.label :slug, "الرابط المختصر" %><%= form.text_field :slug, class: "field" %><%= form.label :description, "الوصف" %><%= form.text_area :description, rows: 5, class: "field" %><%= form.label :image, "الصورة" %><%= form.file_field :image, class: "field" %><%= form.submit "حفظ", class: "button orange" %></div><% end %>