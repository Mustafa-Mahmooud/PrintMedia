<div class="section-head"><div><div class="eyebrow">إدارة الكتالوج</div><h1>التصنيفات</h1></div><%= link_to "إضافة تصنيف +", new_admin_category_path, class: "button orange" %></div><div class="product-grid" style="grid-template-columns:1fr 1fr"><% @categories.each do |category| %><div class="product-card"><div class="product-content"><h3><%= category.name %></h3><p><%= category.products.count %> منتجات · <%= category.slug %></p><div class="product-actions"><%= link_to "تعديل", edit_admin_category_path(category), class: "button ghost" %><%= button_to "حذف", admin_category_path(category), method: :delete, class: "button" %></div></div></div><% end %></div>