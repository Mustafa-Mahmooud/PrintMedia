<%= form_with model: [:admin, product], multipart: true do |form| %><% if product.errors.any? %><div class="flash"><%= product.errors.full_messages.to_sentence %></div><% end %><div style="display:grid;gap:15px;max-width:700px"><%= form.label :name, "اسم المنتج" %><%= form.text_field :name, class: "field" %><%= form.label :slug, "الرابط المختصر" %><%= form.text_field :slug, class: "field" %><%= form.label :model_number, "رقم الموديل" %><%= form.text_field :model_number, class: "field" %><%= form.label :short_description, "وصف مختصر" %><%= form.text_field :short_description, class: "field" %><%= form.label :description, "الوصف التفصيلي" %><%= form.text_area :description, rows: 5, class: "field" %><%= form.label :category_id, "التصنيف" %><%= form.collection_select :category_id, Category.order(:name), :id, :name, {}, class: "field" %><%= form.label :brand_id, "العلامة التجارية" %><%= form.collection_select :brand_id, Brand.order(:name), :id, :name, { include_blank: "بدون علامة" }, class: "field" %><%= form.label :image, "الصورة الرئيسية" %><%= form.file_field :image, class: "field" %><label><%= form.check_box :active %> منتج نشط</label><label><%= form.check_box :featured %> منتج مميز</label><%= form.submit "حفظ المنتج", class: "button orange" %></div><% end %>
