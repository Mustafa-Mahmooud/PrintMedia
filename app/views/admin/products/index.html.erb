<div class="section-head"><div><div class="eyebrow">إدارة الكتالوج</div><h1>المنتجات</h1></div><%= link_to "إضافة منتج +", new_admin_product_path, class: "button orange" %></div><div class="product-grid" style="grid-template-columns:1fr"><% @products.each do |product| %><div class="product-card"><div class="product-content" style="display:flex;justify-content:space-between;align-items:center;gap:15px"><div><div class="product-meta"><%= product.category.name %></div><h3><%= product.name %></h3><p><%= product.active? ? "نشط" : "غير نشط" %> · <%= product.featured? ? "مميز" : "عادي" %></p></div><div class="product-actions"><%= link_to "تعديل", edit_admin_product_path(product), class: "button ghost" %><%= button_to "حذف", admin_product_path(product), method: :delete, class: "button", data: { turbo_confirm: "هل أنت متأكد؟" } %></div></div></div><% end %></div>
