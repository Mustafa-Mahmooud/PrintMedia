<div class="section-head"><h1>تعديل الإعداد</h1><%= link_to "رجوع", admin_site_settings_path, class: "button ghost" %></div><%= form_with model: [:admin, @setting] do |form| %><div style="display:grid;gap:15px;max-width:650px"><%= form.label :key, "المفتاح" %><%= form.text_field :key, class: "field", disabled: true %><%= form.label :value, "القيمة" %><%= form.text_field :value, class: "field" %><%= form.submit "حفظ", class: "button orange" %></div><% end %>